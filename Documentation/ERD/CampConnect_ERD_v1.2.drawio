<mxfile host="Electron">
  <diagram name="CampConnect ERD" id="0">
    <mxGraphModel dx="2020" dy="1204" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2700" pageHeight="1758" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;fontSize=22;fontStyle=1;align=left;" value="CampConnect – Entity Relationship Diagram (Crow's Foot) – v1.2" vertex="1">
          <mxGeometry height="34" width="1100" x="40" y="10" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;fontSize=12;align=left;fontColor=#555555;" value="Logical model aligned to SRS v1.2: Firebase Auth UID as user key, no stored passwords, alumni identity review, admin-only communities, unified Report and AuditLog, plus device-only SQLite tables." vertex="1">
          <mxGeometry height="20" width="1700" x="40" y="44" as="geometry" />
        </mxCell>
        <mxCell id="cmsbox" parent="1" style="rounded=1;html=1;arcSize=4;fillColor=#F7FAFD;strokeColor=#6C8EBF;dashed=0;" value="" vertex="1">
          <mxGeometry height="150" width="1400" x="40" y="74" as="geometry" />
        </mxCell>
        <mxCell id="cmstitle" parent="1" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=12;fontSize=13;" value="&lt;b&gt;CMS ID on registration&lt;/b&gt; – user picks Session and Course from dropdowns, then types only the number" vertex="1">
          <mxGeometry height="22" width="1300" x="56" y="80" as="geometry" />
        </mxCell>
        <mxCell id="cms_s" parent="1" style="rounded=1;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#9AA5B1;fontSize=12;align=left;spacingLeft=10;" value="Session ▾   &lt;b&gt;F24&lt;/b&gt;" vertex="1">
          <mxGeometry height="36" width="170" x="56" y="110" as="geometry" />
        </mxCell>
        <mxCell id="cms_d1" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;" value="–" vertex="1">
          <mxGeometry height="36" width="20" x="230" y="110" as="geometry" />
        </mxCell>
        <mxCell id="cms_c" parent="1" style="rounded=1;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#9AA5B1;fontSize=12;align=left;spacingLeft=10;" value="Course ▾   &lt;b&gt;BSSE&lt;/b&gt;" vertex="1">
          <mxGeometry height="36" width="170" x="254" y="110" as="geometry" />
        </mxCell>
        <mxCell id="cms_d2" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;" value="–" vertex="1">
          <mxGeometry height="36" width="20" x="428" y="110" as="geometry" />
        </mxCell>
        <mxCell id="cms_prefix" parent="1" style="rounded=1;html=1;arcSize=8;fillColor=#E9EDF2;strokeColor=#9AA5B1;fontSize=12;align=left;spacingLeft=10;" value="&lt;b&gt;F24-BSSE-&lt;/b&gt; (auto, read-only)" vertex="1">
          <mxGeometry height="36" width="200" x="452" y="110" as="geometry" />
        </mxCell>
        <mxCell id="cms_num" parent="1" style="rounded=1;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#1A73E8;strokeWidth=2;fontSize=12;align=left;spacingLeft=10;" value="&lt;b&gt;0044&lt;/b&gt;  (user types 4 digits)" vertex="1">
          <mxGeometry height="36" width="200" x="656" y="110" as="geometry" />
        </mxCell>
        <mxCell id="cms_eq" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;" value="→" vertex="1">
          <mxGeometry height="36" width="30" x="862" y="110" as="geometry" />
        </mxCell>
        <mxCell id="cms_res" parent="1" style="rounded=1;html=1;arcSize=30;fillColor=#E2EFDA;strokeColor=#548235;fontSize=14;" value="&lt;b&gt;F24-BSSE-0044&lt;/b&gt;" vertex="1">
          <mxGeometry height="36" width="170" x="896" y="110" as="geometry" />
        </mxCell>
        <mxCell id="cmsnote" parent="1" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=12;" value="Stored as &lt;b&gt;session_id + program_id + cms_number&lt;/b&gt; (composite UNIQUE) and the full &lt;b&gt;cms_id&lt;/b&gt; (UQ); shown as &lt;b&gt;F24-BSSE-0044&lt;/b&gt; in registration, profile, directory, requests, admin screens and audit views. Dropdown lists come from &lt;b&gt;AcademicSession&lt;/b&gt; and &lt;b&gt;Program&lt;/b&gt; (department, semester and other fields are dropdowns too). Admin accounts have no CMS ID (NULL). Releasing a CMS ID (SRS FR-087) clears these fields on the held account and writes an AuditLog row." vertex="1">
          <mxGeometry height="64" width="1370" x="56" y="152" as="geometry" />
        </mxCell>
        <mxCell id="localbox" parent="1" style="rounded=1;html=1;arcSize=3;fillColor=none;strokeColor=#888888;dashed=1;dashPattern=6 4;" value="" vertex="1">
          <mxGeometry height="732" width="322" x="2324" y="210" as="geometry" />
        </mxCell>
        <mxCell id="localtitle" parent="1" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=12;" value="&lt;b&gt;Local SQLite (per device)&lt;/b&gt;&lt;br&gt;Not synchronized with Firebase. owner_uid = User.user_id and resource_id = Resource.resource_id are logical references only; local data is not a backup." vertex="1">
          <mxGeometry height="64" width="306" x="2332" y="212" as="geometry" />
        </mxCell>
