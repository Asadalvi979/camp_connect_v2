rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.get('admin', false) == true; }
    function active() { return signedIn() && get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.status == 'Active'; }
    match /accounts/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow write: if false;
      match /memberships/{communityId} {
        allow read: if active() && request.auth.uid == uid;
        allow write: if false;
      }
    }
    match /profiles/{uid} {
      allow read: if active() && get(/databases/$(database)/documents/accounts/$(uid)).data.status == 'Active';
      allow write: if false;
    }
    match /communities/{id} {
      allow read: if admin() || (active() && resource.data.status == 'Active');
      allow write: if false;
    }
    match /communities/{communityId}/posts/{postId} {
      allow read: if active() && resource.data.status == 'Published' && get(/databases/$(database)/documents/communities/$(communityId)).data.status == 'Active';
      allow write: if false;
      match /comments/{commentId} {
        allow read: if resource.data.status == 'Published' && active() && get(/databases/$(database)/documents/communities/$(communityId)).data.status == 'Active' && get(/databases/$(database)/documents/communities/$(communityId)/posts/$(postId)).data.status == 'Published';
        allow write: if false;
      }
      match /reactions/{uid} {
        allow read: if active() && get(/databases/$(database)/documents/communities/$(communityId)).data.status == 'Active' && get(/databases/$(database)/documents/communities/$(communityId)/posts/$(postId)).data.status == 'Published';
        allow write: if false;
      }
    }
    match /{path=**}/posts/{postId} {
      allow read: if active() && resource.data.status == 'Published' &&
        get(/databases/$(database)/documents/communities/$(resource.data.communityId)).data.status == 'Active';
      allow write: if false;
    }
    match /mentorshipRequests/{id} {
      allow read: if active() && (resource.data.requesterId == request.auth.uid || resource.data.mentorId == request.auth.uid);
      allow write: if false;
    }
    match /reports/{id} {
      allow read: if admin();
      allow write: if false;
    }
    match /auditLog/{id} {
      allow read: if admin();
      allow write: if false;
    }
  }
}
